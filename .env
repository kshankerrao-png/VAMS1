# VAMS API configuration
# Copy to .env at the repository root (or apps/api/.env) and adjust.

PORT=4000
NODE_ENV=development

# SQLite database file, relative to the repository root (used when DATABASE_URL is unset)
DB_PATH=storage/vams.db

# Supabase / PostgreSQL connection string. When set, it takes precedence over SQLite.
# Use the Session Pooler URI and keep sslmode=require:
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# Session cookie and lifetime
COOKIE_SECURE=false
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8

# Background notification worker
WORKER_ENABLED=true
WORKER_INTERVAL_MS=3000

# Allow the demo "simulate delivery" action (never enable in production)
ALLOW_NOTIFICATION_SIMULATION=false

# SMTP relay (leave blank to use the local file transport in development)
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false, SMTP_USER=<address>,
# SMTP_PASSWORD=<16-character app password>, SMTP_FROM="VAMS <address>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="VAMS, T,R&B Department <kshankerrao@gmail.com>"

# WhatsApp Cloud API / BSP (leave blank for the local simulated transport)
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# Twilio WhatsApp (takes precedence over the Cloud API when all three are set)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Trial/sandbox accounts must send a Twilio-provided ContentSid (HX...); leave blank for normal senders
TWILIO_CONTENT_SID=

# Country code prepended to 10-digit mobile numbers (India = 91)
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# Public base URL used in generated documents
APP_BASE_URL=http://localhost:4000
